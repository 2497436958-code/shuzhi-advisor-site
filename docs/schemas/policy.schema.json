{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuzhi-advisor-site/schemas/policy.schema.json",
  "title": "政策库条目",
  "description": "一条政策引用必须有：文号、发布方、发布日期、原文链接、用途与核验记录。",
  "type": "object",
  "required": ["id", "doc_no", "title", "issuer", "publish_date", "url", "role", "used_where", "verified"],
  "properties": {
    "id": { "type": "string", "pattern": "^POLICY-[0-9]{3}$" },
    "doc_no": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "publish_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "doc_type": { "type": "string" },
    "url": { "type": "string", "pattern": "^https?://" },
    "key_provisions": { "type": "array", "items": { "type": "string" } },
    "role": { "type": "string", "minLength": 1 },
    "used_where": { "type": "string", "minLength": 1 },
    "verified": {
      "type": "object",
      "required": ["at", "method"],
      "properties": {
        "at": { "type": "string" },
        "method": { "type": "string", "minLength": 1 }
      }
    }
  }
}
